<?xml version="1.0" encoding="UTF-8"?>
<!-- V7-ADD-004: XML設定と注釈Controllerが併存する世代の構成。 -->
<beans xmlns="http://www.springframework.org/schema/beans">
  <bean id="channelAccessPolicy" class="com.legacysimulator.v07.ChannelAccessPolicy" />
  <bean id="channelDefaults" class="com.legacysimulator.v07.ChannelDefaults" />
  <bean id="channelRecordEnricher" class="com.legacysimulator.v07.ChannelRecordEnricher" />
  <!-- V7-ADD-016: チャネル別入口と共通Service。 -->
  <bean id="channelApplicationService" class="com.legacysimulator.v07.ChannelApplicationService">
    <constructor-arg ref="applicationQueryPort" />
    <constructor-arg ref="channelAccessPolicy" />
    <constructor-arg ref="channelDefaults" />
  </bean>
  <bean id="employeeEntryController" class="com.legacysimulator.v07.EmployeeEntryController">
    <constructor-arg ref="channelApplicationService" />
  </bean>
  <bean id="agencyEntryController" class="com.legacysimulator.v07.AgencyEntryController">
    <constructor-arg ref="channelApplicationService" />
  </bean>
  <bean id="scheduleCoordinationService" class="com.legacysimulator.v07.ScheduleCoordinationService" />
  <bean id="integrationIncidentRouter" class="com.legacysimulator.v07.IntegrationIncidentRouter" />
</beans>
