//*---------------------------------------------------------------
//* V1 DAILY NEW-BUSINESS ASSESSMENT JOB (JCL-EQUIVALENT SAMPLE)
//*---------------------------------------------------------------
//NBJOB01  JOB  CLASS=A,MSGCLASS=A,NOTIFY=OPER
//ASSESS   EXEC PGM=NBASSESS
//STEPLIB  DD   DSN=V1.NEWBUS.LOAD,DISP=SHR
//APPIN    DD   DSN=V1.NEWBUS.APPLICATION,DISP=SHR
//RESULT   DD   DSN=V1.NEWBUS.ASSESSMENT,
//              DISP=(NEW,CATLG,DELETE),
//              DCB=(RECFM=FB,LRECL=80,BLKSIZE=8000)
//SYSOUT   DD   SYSOUT=*
//SYSPRINT DD   SYSOUT=*
//* OPERATION CHECK: INPUT COUNT MUST EQUAL OUTPUT COUNT.
//* RC=00 NORMAL, RC=08 COUNT MISMATCH, RC=12 FILE I/O ERROR.
