//* V4-ADD-005 告知制度施行日対応の日次査定ジョブ。
//* 旧制度・新制度のデータを同じ入力で処理する。
//RGJOB04  JOB (NB),'REGULATORY ASSESS',CLASS=A,MSGCLASS=X
//STEP010  EXEC PGM=RGEXTRCT
//SYSOUT   DD SYSOUT=*
//MASTER   DD DSN=NB.CONTRACT.MASTER,DISP=SHR
//DISCLOSE DD DSN=NB.V04.DISCLOSE(+1),DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(10,5)),DCB=(RECFM=FB,LRECL=80)
//*
//STEP020  EXEC PGM=RGASSESS,COND=(0,NE,STEP010)
//SYSOUT   DD SYSOUT=*
//DISCLOSE DD DSN=NB.V04.DISCLOSE(+1),DISP=SHR
//RGRESULT DD DSN=NB.V04.RGRESULT(+1),DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(10,5)),DCB=(RECFM=FB,LRECL=40)
//*
//STEP030  EXEC PGM=RGAUDIT,COND=(0,NE,STEP020)
//SYSOUT   DD SYSOUT=*
//RGRESULT DD DSN=NB.V04.RGRESULT(+1),DISP=SHR
//AUDIT    DD DSN=NB.V04.RULE.AUDIT(+1),DISP=(NEW,CATLG,DELETE),
//            SPACE=(TRK,(5,2)),DCB=(RECFM=FB,LRECL=80)
//* V4-002 再告知フラグYの件数と適用日を運用担当が確認する。

