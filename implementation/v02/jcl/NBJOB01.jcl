//RESOUT   DD  DSN=NEWBUS.DAILY.ASSESSMENT,
//             DISP=(NEW,CATLG,DELETE),
//             DCB=(RECFM=FB,LRECL=80)
//SYSPRINT DD  SYSOUT=*
//SYSOUT   DD  SYSOUT=*
