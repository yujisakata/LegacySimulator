//MDJOB01  JOB (NEWBUS),'V3 PRODUCT JOBNET',CLASS=A,MSGCLASS=X
//* V3-001 ADD 既存商品と医療系商品を商品別に順次処理する。
//WLSTEP    EXEC PGM=NBASSESS
//WLLOAD    DD  DSN=NEWBUS.V2.LOAD,DISP=SHR
//WLAPP     DD  DSN=NEWBUS.DAILY.APPLICATION,DISP=SHR
//WLRESULT  DD  DSN=NEWBUS.DAILY.ASSESSMENT,DISP=(NEW,CATLG)
//MDSTEP    EXEC PGM=MDASSESS,COND=(0,NE)
//MDLOAD    DD  DSN=NEWBUS.V3.MEDLOAD,DISP=SHR
//MDAPP     DD  DSN=NEWBUS.DAILY.MEDICAL,DISP=SHR,
//             DCB=(RECFM=FB,LRECL=120)
//MDRESULT  DD  DSN=NEWBUS.DAILY.MEDASSESS,
//             DISP=(NEW,CATLG,DELETE),
//             DCB=(RECFM=FB,LRECL=80)
//SYSPRINT  DD  SYSOUT=*
//SYSOUT    DD  SYSOUT=*

